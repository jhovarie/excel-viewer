# ====================
# Node.js / JavaScript
# ====================

# Dependency directories
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json
yarn.lock

# ====================
# Application Specific
# ====================

# Uploads folder - IGNORE ALL FILES IN UPLOADS
uploads/*
!uploads/.gitkeep

# If you want to keep the uploads folder but ignore its contents
# This will keep the folder in git but not the files
# Remove the lines above and uncomment these:
# uploads/
# !uploads/.gitkeep

# Environment variables
.env
.env.local
.env.*.local

